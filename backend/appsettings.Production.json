{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Frontend": {
    "PublicUrl": "http://localhost"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost",
      "http://127.0.0.1",
      "https://localhost"
    ]
  },
  "Jwt": {
    "SecretKey": "WebCafeProductionSecureKey2026_MustBeAtLeast64CharactersLong_VeryStrongSecretKey!",
    "Issuer": "WebCafeBackend",
    "Audience": "WebCafeClients"
  },
  "PayOS": {
    "ClientId": "YOUR_PAYOS_CLIENT_ID",
    "ApiKey": "YOUR_PAYOS_API_KEY",
    "ChecksumKey": "YOUR_PAYOS_CHECKSUM_KEY"
  }
}
